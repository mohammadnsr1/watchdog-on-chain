# ############################################################################
# LOCAL TEST ONLY — these are anvil's publicly known development keys.
#
# Every anvil installation prints these same keys at startup. They are in every
# tutorial and every search engine. ANYONE can spend from these addresses.
# They are safe ONLY on a throwaway local chain.
#
# NEVER put a key that controls anything real in this file or in any file in
# this repository. Copy this file to `.env` (git-ignored) and edit it there.
# For a real network, export the variables from a secret manager instead.
# ############################################################################

# JSON-RPC endpoint of the chain. `anvil` listens here by default.
WDCHAIN_RPC_URL=http://127.0.0.1:8545

# Executor evidence is signed with this key (anvil account #0).
# Address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
WDCHAIN_EXECUTOR_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# WatchDog evidence is signed with a DIFFERENT key (anvil account #1), because the
# executor and the WatchDog are independent witnesses and must be attributable to
# different addresses on-chain (CLAUDE.md rule 2).
# Address: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
WDCHAIN_WATCHDOG_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Optional overrides.
# WDCHAIN_REGISTRY_ADDRESS=0x...        # skip deployments/anvil.json
# WDCHAIN_DEPLOYMENT=deployments/anvil.json
# WDCHAIN_ABI_PATH=out/EvidenceRegistry.sol/EvidenceRegistry.json
